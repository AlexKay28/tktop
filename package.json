{
  "name": "tktop",
  "version": "0.3.0",
  "type": "module",
  "description": "Live htop-style TUI dashboard for AI token consumption across harnesses (OpenCode, Claude Code, Codex, generic JSONL)",
  "keywords": [
    "cli",
    "tui",
    "tokens",
    "llm",
    "ai",
    "monitoring",
    "opentui",
    "htop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AlexKay28/tktop.git"
  },
  "bin": {
    "tktop": "bin/tktop"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "tktop": "bun run src/index.ts",
    "dump": "bun run src/dump.ts",
    "typecheck": "bun check",
    "prepublishOnly": "bun run typecheck"
  },
  "dependencies": {
    "@opentui/core": "^0.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
